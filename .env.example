# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Auth ---------------------------------------------------------------
# Long random string used to sign JWT session tokens:  openssl rand -hex 32
JWT_SECRET=change-me

# --- Optional: Google Cloud Vision OCR fallback -------------------------
GOOGLE_CLOUD_VISION_API_KEY=

# --- Optional: AI Vision & Doctor Assistant -----------------------------
# Anthropic Claude — best at reading handwritten doctor prescriptions
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini — free tier available (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Groq — free tier available (https://console.groq.com/keys)
GROQ_API_KEY=

# Note: You can also connect any of these keys at runtime from the app UI
# (Scan page → "Connect AI Key"), which stores them in .ai-config.json.

# --- Optional: Firebase Cloud Messaging (push reminders) ----------------
# Web app config (Firebase console → Project settings → General)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push certificate key pair (Project settings → Cloud Messaging)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Service account JSON (single line) used by the server to send pushes
FIREBASE_SERVICE_ACCOUNT_JSON=

# Secret protecting POST /api/cron/reminders  (Authorization: Bearer <secret>)
CRON_SECRET=
